# Browser-safe Supabase settings. Leave blank for local-only demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Gemini credentials. Leave blank to use clearly labelled fallbacks.
# NEVER use the VITE_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Server-side Supabase writes (never prefix with VITE_; never expose in frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Node API server
PORT=8787
# Reverse-proxy hops in production (Embarko commonly sits behind one proxy).
TRUST_PROXY_HOPS=1

# Exact comma-separated browser origins allowed by CORS.
# Local development:
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
